@startuml
skinparam classAttributeIconSize 0

abstract class Користувач {
  +id: Int
  +імя: String
  +email: String
  +телефон: String
  +парольHash: String
  +авторизуватись(): Bool
  +вийти(): Void
  +змінитиПароль(новийПароль: String): Bool
  +оновитиПрофіль(імя: String, телефон: String): Void
  +підтвердитиEmail(): Bool
}

class Платник {
  +idПлатника: String
  +баланс: Float
  +бонусніБали: Int
  +статусАктивний: Bool
  +улюбленийМетодОплати: String
  +додатиРахунок(рахунок: Особовий_рахунок): Void
  +видалитиРахунок(idРахунку: Int): Bool
  +переглянутиБорг(): Float
  +здійснитиОплату(сума: Float): Bool
  +завантажитиКвитанцію(idТранзакції: String): File
}

class Адміністратор {
  +рівеньДоступу: Int
  +відділ: String
  +останнійВхідIP: String
  +журналДій: List
  +можеЗмінюватиТарифи: Bool
  +заблокуватиПлатника(idПлатника: String): Bool
  +розблокуватиПлатника(idПлатника: String): Bool
  +оновитиТариф(idПослуги: Int, новийТариф: Float): Void
  +згенеруватиЗвіт(дата: Date): File
  +вирішитиСкаргу(idСкарги: Int): Bool
}

class Особовий_рахунок {
  +idРахунку: String
  +загальнийБорг: Float
  +кількістьМешканців: Int
  +площаКвартири: Float
  +датаСтворення: Date
  +розрахуватиБорг(): Float
  +додатиПослугу(послуга: Послуга): Void
  +видалитиПослугу(idПослуги: Int): Bool
  +отриматиІнформацію(): String
  +оновитиМешканців(кількість: Int): Void
}

class Адреса {
  +місто: String
  +вулиця: String
  +будинок: String
  +квартира: String
  +індекс: String
  +отриматиПовнуАдресу(): String
  +змінитиАдресу(місто: String, вулиця: String): Bool
  +перевіритиІндекс(): Bool
  +отриматиКоординати(): Point
  +форматуватиДляДруку(): String
}

abstract class Послуга {
  +idПослуги: Int
  +назва: String
  +постачальник: String
  +тариф: Float
  +опис: String
  +отриматиТариф(): Float
  +встановитиТариф(новийТариф: Float): Void
  +розрахуватиВартість(): Float
  +отриматиІнфоПроПостачальника(): String
  +вимкнутиПослугу(): Bool
}

class Послуга_з_лічильником {
  +серійнийНомерЛічильника: String
  +поточнийПоказник: Float
  +попереднійПоказник: Float
  +одиницяВиміру: String
  +датаОстанньоїПовірки: Date
  +передатиПоказник(новийПоказник: Float): Bool
  +розрахуватиСпоживання(): Float
  +перевіритиПоказник(значення: Float): Bool
  +заплануватиПовірку(): Void
  +історіяПоказників(): List
}

class Транзакція_оплати {
  +idТранзакції: String
  +сума: Float
  +датаЧас: Date
  +статус: String
  +методОплати: String
  +обробитиОплату(): Bool
  +скасуватиОплату(): Bool
  +перевіритиСтатус(): String
  +згенеруватиКвитанцію(): Квитанція
  +повернутиКошти(сума: Float): Bool
}

class Квитанція {
  +idКвитанції: String
  +файлPDF: File
  +датаГенерації: Date
  +електроннийПідпис: String
  +завантажена: Bool
  +створитиPDF(транзакція: Транзакція_оплати): File
  +відправитиНаEmail(email: String): Bool
  +перевіритиПідпис(): Bool
  +друкувати(): Void
  +отриматиДаніКвитанції(): String
}

class Банківський_шлюз {
  +idШлюзу: String
  +urlAPI: String
  +ключAPI: String
  +таймаутМс: Int
  +підтримуваніВалюти: List
  +авторизуватиКартку(дані: String): Bool
  +списатиКошти(idТранзакції: String): Bool
  +перевіритиБалансШлюзу(): Float
  +повернутиТранзакцію(idТранзакції: String): Bool
  +перевіритиЗвязок(): Bool
}

' Відношення наслідування (generalization)
Платник --|> Користувач : наслідує
Адміністратор --|> Користувач : наслідує
Послуга_з_лічильником --|> Послуга : наслідує

' Відношення композиції (composition) - ціле і частина вмирають разом
Платник "1" *-- "1..*" Особовий_рахунок : включає
Особовий_рахунок "1" *-- "1" Адреса : має

' Відношення агрегації (aggregation) - частина може існувати окремо
Особовий_рахунок "1" o-- "1..*" Послуга : містить
Транзакція_оплати "1" o-- "1" Квитанція : формує

' Відношення асоціації (association)
Платник "1" --> "0..*" Транзакція_оплати : здійснює

' Відношення інстанціювання / залежність (instantiation / dependency)
Транзакція_оплати ..> Банківський_шлюз : <<instantiate>>
@enduml